#!/bin/sh
# Block push if any commit in the range was not authored by the canonical author.

EXPECTED="Akshat Dubey <akshat.dubey@salescode.ai>"

while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi

  bad=$(git log --format="%H %an <%ae>" $range | grep -v " $EXPECTED$" || true)

  if [ -n "$bad" ]; then
    echo "pre-push: commits with unexpected author found — push blocked."
    echo ""
    echo "Expected author: $EXPECTED"
    echo ""
    echo "Offending commits:"
    echo "$bad"
    echo ""
    echo "Fix with: git rebase --exec 'git commit --amend --no-edit --reset-author' <base-sha>"
    exit 1
  fi
done

exit 0
