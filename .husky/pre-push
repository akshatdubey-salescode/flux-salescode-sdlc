#!/bin/sh
# Auto-fix commit authors before push.
# If wrong-author commits are found, rewrites them and exits 1 so you re-run git push.
# On the second push all authors are correct and it goes through.

AUTHOR_NAME="Akshat Dubey"
AUTHOR_EMAIL="akshat.dubey@salescode.ai"
EXPECTED="$AUTHOR_NAME <$AUTHOR_EMAIL>"

fixed=0

while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi

  bad=$(git log --format="%H %an <%ae>" $range | grep -v " $EXPECTED$" || true)
  [ -z "$bad" ] && continue

  echo "pre-push: wrong-author commits found — auto-fixing..."
  echo "$bad"
  echo ""

  oldest=$(git log --reverse --format="%H %an <%ae>" $range \
    | grep -v " $EXPECTED$" || true | head -1 | awk '{print $1}')
  base=$(git rev-parse "${oldest}^" 2>/dev/null || true)

  if [ -z "$base" ]; then
    rebase_arg="--root"
  else
    rebase_arg="$base"
  fi

  GIT_COMMITTER_NAME="$AUTHOR_NAME" \
  GIT_COMMITTER_EMAIL="$AUTHOR_EMAIL" \
  git rebase --exec \
    "git commit --amend --no-edit --allow-empty --author='$EXPECTED'" \
    $rebase_arg

  if [ $? -ne 0 ]; then
    echo "pre-push: rebase failed — run 'git rebase --abort' and fix manually."
    exit 1
  fi

  fixed=1
done

if [ "$fixed" = "1" ]; then
  echo "pre-push: authors corrected — run 'git push' again to complete."
  exit 1
fi

exit 0
